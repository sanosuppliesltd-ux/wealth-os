{
  "name": "wealth-os",
  "version": "0.1.0",
  "private": true,
  "description": "Wealth OS — personal wealth-management and retirement-planning application (Phase 0: production foundation)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "next": "15.5.25",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "20.19.15",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "tailwindcss": "3.4.19",
    "postcss": "8.5.6",
    "autoprefixer": "10.4.21",
    "vitest": "2.1.9",
    "prisma": "6.19.3",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.25",
    "@eslint/eslintrc": "3.3.1"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "unrs-resolver"
    ]
  }
}
