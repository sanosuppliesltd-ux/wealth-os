# Wealth OS — environment variables
# Copy this file to .env and adjust values for your environment.
# Never commit a real .env file.

# Prisma / database connection.
# Local development uses SQLite — no external database server required.
DATABASE_URL="file:./dev.db"

# Base URL the app is served from. Used only for absolute links if/when
# needed; not required for local development.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Node runtime environment (development | production | test).
NODE_ENV="development"

# ---------------------------------------------------------------------
# Placeholders for future phases (do NOT populate in Phase 0):
# - external market/fund data API keys (e.g. Al Meezan, SBP, PSX)
# - AI provider API keys
# - authentication provider secrets
# These are intentionally absent. No external or AI integrations exist
# in this phase.
# ---------------------------------------------------------------------
